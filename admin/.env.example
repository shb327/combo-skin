# Copy to .env.local to change the API origin. Values here are placeholders.
# Every VITE_ variable ends up in the built JavaScript: never put a secret in one.
# The API origin: http(s), a host and an optional port, no path or trailing slash.
# Plain http only for localhost. Default: http://localhost:8000
# VITE_API_BASE_URL=https://api.example.com

# Where combo screenshots are loaded from: an origin with the same rules, allowed in the
# Content Security Policy's img-src. Default: the local storage service of the Compose stack.
# VITE_IMAGE_ORIGIN=http://localhost:9000
