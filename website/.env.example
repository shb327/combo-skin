# Optional: the API's origin. Defaults to the local API.
# VITE_API_BASE_URL=http://localhost:8000

# Optional: extra dev server hosts, comma-separated (for example a tunnel).
# DEV_ALLOWED_HOSTS=tunnel.example.com

# Optional: the public image bucket's base URL, where combo screenshots and our copies of the
# catalog's pictures load from (https; plain http only on localhost; a path is allowed).
# Defaults to the local storage service's public bucket.
# VITE_IMAGE_BASE_URL=http://localhost:9000/local-images

# Optional: the 3D viewer's origin for "View in 3D", an origin with the same rules (plain http
# also on 127.0.0.1). Defaults to the viewer's local production build. The hosted viewer also
# accepts this site's dev and preview servers (ports 5173 and 4173).
# VITE_VIEWER_ORIGIN=http://127.0.0.1:5321
