# Copy to .env for local development. Placeholder values only: never commit a real .env.
# Compose passes this file to the db, migrate and api containers, and sets
# POSTGRES_HOST=db and POSTGRES_PORT=5432 for migrate and api.
POSTGRES_HOST=localhost
POSTGRES_PORT=54320
POSTGRES_USER=combo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=combo
LOG_LEVEL=info
DOCS_ENABLED=true
# Origins allowed to send logged-in requests: the admin dashboard's local dev server.
ADMIN_ORIGINS=http://localhost:5174
# Local http only. Production keeps the default, true.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Reverse proxies whose forwarded headers are trusted. None locally.
TRUSTED_PROXIES=
# Object storage through the S3 API: the Compose service `storage` (RustFS) locally, which
# Compose reaches at http://storage:9000 from containers. Local placeholder values only.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=local-storage
STORAGE_SECRET_ACCESS_KEY=change-me-storage
# Two buckets that must differ: originals are never public; the public bucket is readable by
# anyone at IMAGE_BASE_URL (https, or http on localhost; path-style locally).
STORAGE_ORIGINALS_BUCKET=local-originals
STORAGE_PUBLIC_BUCKET=local-images
IMAGE_BASE_URL=http://localhost:9000/local-images
