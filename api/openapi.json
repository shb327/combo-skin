  "info": {
    "title": "Combo Skin API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/gloves": {
      "get": {
        "description": "Glove types in display order.",
        "operationId": "list_glove_types",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TypeSummary"
                  },
                  "title": "Response List Glove Types",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found"
          }
        },
        "summary": "List Glove Types",
        "tags": [
          "catalog"
        ]
      }
    },
    "/gloves/{type_slug}": {
      "get": {
        "description": "One glove type with its finishes in display order.",
        "operationId": "get_glove_type",
        "parameters": [
          {
            "in": "path",
            "name": "type_slug",
            "required": true,
            "schema": {
              "title": "Type Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TypeDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Glove Type",
        "tags": [
          "catalog"
        ]
      }
    },
    "/gloves/{type_slug}/{finish_slug}": {
      "get": {
        "description": "One glove finish, including one no longer in the game (`active: false`).",
        "operationId": "get_glove_finish",
        "parameters": [
          {
            "in": "path",
            "name": "type_slug",
            "required": true,
            "schema": {
              "title": "Type Slug",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "finish_slug",
