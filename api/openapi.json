                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Glove Types",
        "tags": [
          "catalog"
        ]
      }
    },
    "/gloves/{type_slug}": {
      "get": {
        "description": "One glove type with its finishes in display order.",
        "operationId": "get_glove_type",
        "parameters": [
          {
            "in": "path",
            "name": "type_slug",
            "required": true,
            "schema": {
              "title": "Type Slug",
