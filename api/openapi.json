        "summary": "Get Glove Type",
        "tags": [
          "catalog"
        ]
      }
    },
    "/gloves/{type_slug}/{finish_slug}": {
      "get": {
        "description": "One glove finish, including one no longer in the game (`active: false`) or whose type\nis not (`item_type.active: false`).",
        "operationId": "get_glove_finish",
        "parameters": [
          {
            "in": "path",
            "name": "type_slug",
            "required": true,
            "schema": {
              "title": "Type Slug",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "finish_slug",
            "required": true,
            "schema": {
              "title": "Finish Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
