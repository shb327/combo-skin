              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinishDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Glove Finish",
        "tags": [
          "catalog"
